{#
/**
 * @file
 * Encargos. El titular es el resumen del texto; las tarjetas de servicios
 * salen de jllamas_site.settings (servicios).
 */
#}
<main>
  <section class="mx-auto max-w-[1500px] px-5 pb-20 pt-10 md:px-10 md:pt-20">
    <p class="eyebrow">{{ node.label }} · Negocios y particulares</p>
    <h1 class="mt-3 max-w-5xl text-5xl font-light leading-[0.98] md:text-7xl">{{ jl.entradilla ?: node.label }}</h1>
    <div class="prose-jl mt-8 max-w-xl text-muted-foreground">{{ content.body }}</div>
  </section>
  <section class="mx-auto mb-28 grid max-w-[1500px] gap-x-10 gap-y-20 px-5 md:grid-cols-2 md:px-10 xl:grid-cols-3">
    {% for s in jl.servicios %}
      <article>
        <div class="flex aspect-[4/5] items-center justify-center bg-paper-deep p-6">
          {% if s.obra %}
            <div style="width: {{ s.obra.ancho > s.obra.alto ? '100%' : ((s.obra.ancho / s.obra.alto * 100)|round(2) ~ '%') }}">
              <span class="art-img block" style="aspect-ratio: {{ s.obra.ancho }} / {{ s.obra.alto }}">{{ s.obra.imagen }}</span>
            </div>
          {% endif %}
        </div>
        <h2 class="mt-6 text-3xl font-light">{{ s.titulo }}</h2>
        <p class="mt-3 text-muted-foreground">{{ s.texto }}</p>
        <a href="{{ s.url }}" class="mt-4 inline-block text-sm link-underline text-primary">Pedir presupuesto →</a>
      </article>
    {% endfor %}
  </section>
  {{ jl.proceso }}
</main>
