{#
/**
 * @file
 * Retratos por encargo.
 */
#}
<main>
  <section class="mx-auto max-w-[1500px] px-5 pb-16 pt-10 md:px-10 md:pt-20">
    <p class="eyebrow">{{ categoria }} · {{ total }} obras</p>
    <h1 class="mt-3 max-w-4xl text-6xl font-light leading-[0.95] md:text-8xl">
      Retratos <em class="text-primary">por encargo</em>
    </h1>
    <p class="mt-6 max-w-xl text-muted-foreground">
      Retratos de colores planos, de personas y también de mascotas, a partir de tus fotografías. Para tenerlo o para regalar.
    </p>
    <a href="{{ url_encargo }}" class="mt-8 inline-block bg-primary px-6 py-3 text-sm text-primary-foreground hover:opacity-90">Encargar un retrato</a>
  </section>
  <section class="mx-auto mb-28 max-w-[1500px] px-5 md:px-10">
    <div class="columns-2 gap-5 md:columns-3 md:gap-8 xl:columns-4">
      {% for obra in obras %}
        {{ include('@jllamas_site/jllamas-tarjeta.html.twig', {obra: obra}) }}
      {% endfor %}
    </div>
  </section>
  {{ proceso }}
</main>
